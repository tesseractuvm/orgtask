# ============================================================================
# OrgTask · Plantilla de variables de entorno
#
# Este archivo SI se sube al repositorio: es la documentacion de que variables
# necesita el proyecto. No contiene valores reales.
#
# Para trabajar en tu equipo: copia este archivo como .env y reemplaza los
# valores. El archivo .env esta en .gitignore, asi que nunca se sube.
#
#     Copy-Item .env.example .env
#
# ----------------------------------------------------------------------------
# De donde salen estos valores
#
# Panel de Supabase > tu proyecto > Project Settings > API Keys
#   VITE_SUPABASE_URL              seccion Project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY  seccion Publishable key (empieza con sb_publishable_)
#
# ----------------------------------------------------------------------------
# Por que las dos llevan el prefijo VITE_
#
# Vite solo entrega al navegador las variables que empiezan con VITE_. Ese
# prefijo tambien significa que el valor queda escrito dentro del archivo
# JavaScript que se descarga: cualquiera puede leerlo con las herramientas de
# desarrollo del navegador.
#
# Eso esta bien para estas dos. La clave publishable esta disenada para ser
# publica: por si sola no da acceso a ningun dato. Lo que protege la base de
# datos son las politicas RLS.
#
# NUNCA agregues aqui una clave que empiece con sb_secret_. Esa clave da acceso
# total y salta todas las politicas de seguridad. Su unico lugar es el panel de
# Supabase, como secreto de la Edge Function.
# ============================================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_con_tu_clave

# ----------------------------------------------------------------------------
# Solo para el servidor: administracion de personas
#
# Estas dos NO llevan el prefijo VITE_, y esa ausencia es lo que las protege:
# Vite solo entrega al navegador las variables que empiezan con VITE_, asi que
# estas se quedan del lado del servidor.
#
# Las usa api/admin-users.js, la funcion de Vercel que crea cuentas, asigna
# contrasenas y genera el acceso de prueba. Son las unicas operaciones que
# necesitan saltarse las politicas RLS.
#
# La clave secreta sale del panel de Supabase > Project Settings > API Keys,
# seccion Secret keys. Da acceso total a la base de datos: no la compartas ni la
# pongas nunca en una variable con prefijo VITE_.
#
# En Vercel se agregan en Settings > Environment Variables, marcando Production,
# Preview y Development.
# ----------------------------------------------------------------------------

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_reemplaza_con_tu_clave_secreta
